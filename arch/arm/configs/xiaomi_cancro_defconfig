# Core Platform Architecture
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_MSM8974=y
CONFIG_SMP=y
CONFIG_ARM_LPAE=n
CONFIG_CPU_V7=y
CONFIG_AEABI=y
CONFIG_HIGHMEM=y

# Power Management & System Core
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_WQ_POWER_EFFICIENT=y
CONFIG_ARM_PSCI=y
CONFIG_QCOM_RPM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_LOCAL_POWER_RAIL=y

# Bus and Interfaces
CONFIG_ARM_AMBA=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_GENERIC_PINCTRL=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_MSM8974=y

# Regulators (PM8941)
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_REGULATOR_QCOM_RPM=y

# Storage Controllers (eMMC)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y

# Display Subsystem (Sharp FHD Video Panel)
CONFIG_HAS_IOMMU=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_QCOM_IOMMU=y
CONFIG_DRM=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SIMPLE=y

# Backlight & LEDs
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_QCOM_WLED=y
CONFIG_PWM=y
CONFIG_PWM_QCOM_LPG=y

# Input Mechanisms (Synaptics Touch & Buttons)
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_GPIO_KEYS=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_TOUCHSCREEN_SYNAPTICS_RMI4=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y

# Serial & Debugging
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# Wireless & Remote Processors (WCN3680 WiFi/BT)
CONFIG_NET=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WCN36XX=y
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_WCNSS_CTRL=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_QCOM_SMD=y

# Bluetooth
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y

# USB Core
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_MSM_OTG=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y

# File Systems & Base Requirements
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y

